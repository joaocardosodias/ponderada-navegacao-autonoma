<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cg_navigator</name>
  <version>0.1.0</version>
  <description>Autonomous maze navigation (Part 1) and sensor-based mapping + verification (Part 2) for Culling Games.</description>
  <maintainer email="joao.dias@sou.inteli.edu.br">João Cardoso Dias</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>cg_interfaces</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
